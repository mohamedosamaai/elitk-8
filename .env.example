# ──────────────────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public-facing URL (used for CORS, canonical links, PWA manifest)
APP_URL=https://your-domain.com

# ──────────────────────────────────────────────────────────
# Database Configuration (PostgreSQL / Drizzle ORM)
# ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/elitk8_db

# ──────────────────────────────────────────────────────────
# AI Engine Configuration
# ──────────────────────────────────────────────────────────

# Google Gemini API key — obtain from: https://aistudio.google.com
# NEVER inject this at build time. Keep server-side only.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use — override without code changes
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud TTS API — server-side speech synthesis proxy
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Google Cloud Project ID (for Vertex AI / GCP resource billing)
GCP_PROJECT_ID=your_gcp_project_id_here

# Cloudflare Worker URL — edge-compatible background handler
CLOUDFLARE_WORKER_URL=https://your-worker-subdomain.workers.dev

# ──────────────────────────────────────────────────────────
# Observability & Logging
# ──────────────────────────────────────────────────────────

# Optional: endpoint for central conversation logger
CHAT_LOGGER_URL=

# Optional: authentication token for the conversation logger (server-side only)
LOGGER_API_KEY=

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
