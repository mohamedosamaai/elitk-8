# ─── Application ─────────────────────────────────────────────────────────────
# Public URL where this service is hosted (used for self-referential links and CORS)
APP_URL=https://8.elitk.com

# Server port (defaults to 3000 in development, 8080 in Docker)
PORT=3000

# ─── AI ──────────────────────────────────────────────────────────────────────
# Gemini API key — obtain from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# Google Cloud API key — used server-side for the Text-to-Speech proxy
GOOGLE_TTS_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
# Optional: endpoint for the central conversation logger
CHAT_LOGGER_URL=

# Optional: authentication token for the conversation logger
LOGGER_API_KEY=
