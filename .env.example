# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public-facing URL (used for CORS, canonical links, PWA manifest)
APP_URL=https://8.elitk.com

# ─────────────────────────────────────────────────────────────────────────────
# Google AI Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key — obtain from: https://aistudio.google.com
# NEVER inject this at build time. Keep server-side only.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use — override without code changes
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────────────────────
# Google Cloud Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Google Cloud TTS API — server-side speech synthesis proxy
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Google Cloud Project ID (for Firebase / GCP resource billing)
GCP_PROJECT_ID=your_gcp_project_id_here

# ─────────────────────────────────────────────────────────────────────────────
# Observability & Logging
# ─────────────────────────────────────────────────────────────────────────────

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
