{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,

    // Core strict safety — protects against implicit any and null bugs
    "strict": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // Note: noUnusedLocals, noUnusedParameters, noImplicitReturns are enforced
    // by ESLint rules instead, allowing per-file suppression during refactoring.

    // Library compatibility
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    // Path aliases
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "tests"],
  "exclude": ["node_modules", "dist"]
}
